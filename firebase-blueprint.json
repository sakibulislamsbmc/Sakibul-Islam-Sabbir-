{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated client profile and billing preferences stored per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the user.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user.",
          "minLength": 3,
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "phone": {
          "type": "string",
          "description": "Phone or WhatsApp contact number.",
          "minLength": 0,
          "maxLength": 40
        },
        "company": {
          "type": "string",
          "description": "Company, brand, or organization name.",
          "minLength": 0,
          "maxLength": 100
        },
        "roleTitle": {
          "type": "string",
          "description": "Job title or role within the organization.",
          "minLength": 0,
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "City and country for billing and timezone alignment.",
          "minLength": 0,
          "maxLength": 120
        },
        "preferredBillingMethod": {
          "type": "string",
          "description": "Default payment method selected by the client.",
          "enum": [
            "bKash",
            "Nagad",
            "Dutch-Bangla Bank",
            "Visa / Mastercard",
            "PayPal",
            "Wire Transfer"
          ]
        },
        "billingDetails": {
          "type": "string",
          "description": "Masked billing identifier or account details.",
          "minLength": 0,
          "maxLength": 120
        },
        "bio": {
          "type": "string",
          "description": "Client notes, project preferences, or brief bio.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "phone",
        "company",
        "roleTitle",
        "location",
        "preferredBillingMethod",
        "billingDetails",
        "bio",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectOrder": {
      "title": "ProjectOrder",
      "description": "Project order record containing scope, billing method, order date, and invoice details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the client who placed the order.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order/invoice reference code.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "projectTitle": {
          "type": "string",
          "description": "Name of the project or deliverable ordered.",
          "minLength": 2,
          "maxLength": 120
        },
        "serviceCategory": {
          "type": "string",
          "description": "Service vertical for the project.",
          "enum": [
            "Web Development",
            "App Development",
            "Graphic & Brand Design",
            "Video Editing & Motion",
            "Digital Media & Growth"
          ]
        },
        "packageTier": {
          "type": "string",
          "description": "Selected package tier.",
          "enum": ["Starter", "Professional", "Enterprise", "Custom"]
        },
        "amountUsd": {
          "type": "number",
          "description": "Legacy USD reference equivalent."
        },
        "amountBdt": {
          "type": "number",
          "description": "Total billed amount in Bangladeshi Taka (BDT)."
        },
        "billingMethod": {
          "type": "string",
          "description": "Payment method used for the order.",
          "enum": [
            "bKash",
            "Nagad",
            "Dutch-Bangla Bank",
            "Visa / Mastercard",
            "PayPal",
            "Wire Transfer"
          ]
        },
        "billingReference": {
          "type": "string",
          "description": "Masked account number, transaction ID, or billing reference.",
          "minLength": 2,
          "maxLength": 80
        },
        "billingStatus": {
          "type": "string",
          "description": "Current payment status of the order.",
          "enum": ["Paid", "Pending Verification", "Installment (50% Paid)"]
        },
        "projectStatus": {
          "type": "string",
          "description": "Current lifecycle status of the project order.",
          "enum": ["In Progress", "In Review", "Completed", "Cancelled"]
        },
        "orderDate": {
          "type": "string",
          "description": "Formatted or ISO date string when the order was placed.",
          "minLength": 8,
          "maxLength": 32
        },
        "completedDate": {
          "type": "string",
          "description": "Formatted or ISO date string when the project work was completed.",
          "minLength": 0,
          "maxLength": 32
        },
        "deliveryEstimate": {
          "type": "string",
          "description": "Estimated delivery window or milestone date.",
          "minLength": 2,
          "maxLength": 60
        },
        "projectNotes": {
          "type": "string",
          "description": "Project brief, deliverables, and special instructions.",
          "minLength": 0,
          "maxLength": 1000
        },
        "clientName": {
          "type": "string",
          "description": "Client name recorded on the order receipt.",
          "minLength": 1,
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "format": "email",
          "description": "Client email recorded on the order receipt.",
          "minLength": 3,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the order was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the order was last updated."
        }
      },
      "required": [
        "uid",
        "orderNumber",
        "projectTitle",
        "serviceCategory",
        "packageTier",
        "amountUsd",
        "billingMethod",
        "billingReference",
        "billingStatus",
        "projectStatus",
        "orderDate",
        "deliveryEstimate",
        "projectNotes",
        "clientName",
        "clientEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoursePurchase": {
      "title": "CoursePurchase",
      "description": "Course enrollment, payment verification record, and learner completion progress per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the enrolled student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "description": "Unique slug identifier of the course.",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "courseTitle": {
          "type": "string",
          "description": "Display title of the course.",
          "minLength": 2,
          "maxLength": 150
        },
        "courseRoute": {
          "type": "string",
          "description": "Frontend route path for opening the course.",
          "minLength": 1,
          "maxLength": 100
        },
        "courseType": {
          "type": "string",
          "description": "Whether this course is paid or free.",
          "enum": ["Paid Course", "Free Course"]
        },
        "amountBdt": {
          "type": "number",
          "description": "Course enrollment fee in BDT (0 for free courses)."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment channel used for enrollment.",
          "enum": [
            "bKash",
            "Nagad",
            "Dutch-Bangla Bank",
            "Visa / Mastercard",
            "PayPal",
            "Wire Transfer",
            "Free Enrollment"
          ]
        },
        "paymentReference": {
          "type": "string",
          "description": "Transaction ID, sender account reference, or free enrollment marker.",
          "minLength": 2,
          "maxLength": 100
        },
        "paymentStatus": {
          "type": "string",
          "description": "Verification status controlling classroom access.",
          "enum": ["Pending Verification", "Verified", "Rejected"]
        },
        "studentName": {
          "type": "string",
          "description": "Full name of the student.",
          "minLength": 1,
          "maxLength": 100
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "description": "Google Account email used for purchase.",
          "minLength": 3,
          "maxLength": 150
        },
        "studentPhone": {
          "type": "string",
          "description": "WhatsApp or phone number for live batch onboarding.",
          "minLength": 0,
          "maxLength": 40
        },
        "completedLessonIds": {
          "type": "array",
          "description": "Bounded list of completed lesson IDs.",
          "items": {
            "type": "string"
          }
        },
        "completedLessonsCount": {
          "type": "integer",
          "description": "Number of completed lessons."
        },
        "totalLessonsCount": {
          "type": "integer",
          "description": "Total number of lessons in the course."
        },
        "progressPct": {
          "type": "integer",
          "description": "Percentage completion (0 to 100)."
        },
        "averageQuizScore": {
          "type": "number",
          "description": "Average percentage score across submitted quizzes."
        },
        "lastActiveLessonTitle": {
          "type": "string",
          "description": "Title of the most recently opened or completed class.",
          "minLength": 0,
          "maxLength": 140
        },
        "verifiedByEmail": {
          "type": "string",
          "description": "Verified admin email if reviewed.",
          "minLength": 0,
          "maxLength": 150
        },
        "adminNote": {
          "type": "string",
          "description": "Admin verification remark or batch onboarding note.",
          "minLength": 0,
          "maxLength": 300
        },
        "purchaseDate": {
          "type": "string",
          "description": "ISO date string when enrollment was created.",
          "minLength": 8,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when purchase record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when purchase or progress was last updated."
        }
      },
      "required": [
        "uid",
        "courseId",
        "courseTitle",
        "courseRoute",
        "courseType",
        "amountBdt",
        "paymentMethod",
        "paymentReference",
        "paymentStatus",
        "studentName",
        "studentEmail",
        "studentPhone",
        "completedLessonIds",
        "completedLessonsCount",
        "totalLessonsCount",
        "progressPct",
        "averageQuizScore",
        "lastActiveLessonTitle",
        "verifiedByEmail",
        "adminNote",
        "purchaseDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "WebsiteNotice": {
      "title": "WebsiteNotice",
      "description": "Website announcements and course/workshop/service notices displayed inside the client account dashboard.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Notice headline.",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "description": "Notice category.",
          "enum": ["General", "Course Update", "Workshop", "Offer", "Maintenance"]
        },
        "body": {
          "type": "string",
          "description": "Detailed notice message.",
          "minLength": 4,
          "maxLength": 1500
        },
        "actionLabel": {
          "type": "string",
          "description": "Optional CTA label for navigating to a related section.",
          "minLength": 0,
          "maxLength": 60
        },
        "actionRoute": {
          "type": "string",
          "description": "Optional relative website route.",
          "minLength": 0,
          "maxLength": 120
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the notice is visible to signed-in users."
        },
        "publishedDate": {
          "type": "string",
          "description": "ISO date string for the notice.",
          "minLength": 8,
          "maxLength": 32
        },
        "publishedByEmail": {
          "type": "string",
          "format": "email",
          "description": "Verified admin email who published the notice.",
          "minLength": 3,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the notice was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the notice was last updated."
        }
      },
      "required": [
        "title",
        "category",
        "body",
        "actionLabel",
        "actionRoute",
        "isPublished",
        "publishedDate",
        "publishedByEmail",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private client profile documents keyed by Firebase Auth UID."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/ProjectOrder" },
      "description": "Client project orders containing billing method, order date, completed date, BDT amount, and downloadable receipt metadata."
    },
    "/coursePurchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/CoursePurchase" },
      "description": "Course enrollment, payment verification status, and per-user lesson progress records."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/WebsiteNotice" },
      "description": "Website announcements published by admins and visible inside the account dashboard."
    }
  }
}
