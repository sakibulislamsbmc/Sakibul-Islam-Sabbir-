rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Primary Admin Lock: ONLY sakibulislamsbmc@gmail.com with verified email holds admin privileges
    function isCourseAdmin() {
      return isVerifiedUser() &&
        'email' in request.auth.token &&
        request.auth.token.email == 'sakibulislamsbmc@gmail.com';
    }

    function isValidBillingMethod(method) {
      return method is string && method.size() <= 40 && method in [
        'bKash',
        'Nagad',
        'Dutch-Bangla Bank',
        'Visa / Mastercard',
        'PayPal',
        'Wire Transfer'
      ];
    }

    function isValidCoursePaymentMethod(method) {
      return method is string && method.size() <= 40 && method in [
        'bKash',
        'Nagad',
        'Dutch-Bangla Bank',
        'Visa / Mastercard',
        'PayPal',
        'Wire Transfer',
        'Free Enrollment'
      ];
    }

    function isValidApplicationMethod(method) {
      return method is string && method.size() <= 40 && method in [
        'bKash',
        'Nagad',
        'Dutch-Bangla Bank',
        'Visa / Mastercard',
        'PayPal',
        'Wire Transfer',
        'Free Request'
      ];
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'photoURL',
        'phone',
        'company',
        'roleTitle',
        'location',
        'preferredBillingMethod',
        'billingDetails',
        'bio',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'photoURL',
        'phone',
        'company',
        'roleTitle',
        'location',
        'preferredBillingMethod',
        'billingDetails',
        'bio',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.photoURL is string && data.photoURL.size() >= 0 && data.photoURL.size() <= 500 &&
      data.phone is string && data.phone.size() >= 0 && data.phone.size() <= 40 &&
      data.company is string && data.company.size() >= 0 && data.company.size() <= 100 &&
      data.roleTitle is string && data.roleTitle.size() >= 0 && data.roleTitle.size() <= 100 &&
      data.location is string && data.location.size() >= 0 && data.location.size() <= 120 &&
      isValidBillingMethod(data.preferredBillingMethod) &&
      data.billingDetails is string && data.billingDetails.size() >= 0 && data.billingDetails.size() <= 120 &&
      data.bio is string && data.bio.size() >= 0 && data.bio.size() <= 500 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: ProjectOrder (/orders/{orderId})
    function isValidProjectOrder(data) {
      return data.keys().hasAll([
        'uid',
        'orderNumber',
        'projectTitle',
        'serviceCategory',
        'packageTier',
        'amountUsd',
        'billingMethod',
        'billingReference',
        'billingStatus',
        'projectStatus',
        'orderDate',
        'deliveryEstimate',
        'projectNotes',
        'clientName',
        'clientEmail',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'orderNumber',
        'projectTitle',
        'serviceCategory',
        'packageTier',
        'amountUsd',
        'amountBdt',
        'billingMethod',
        'billingReference',
        'billingStatus',
        'projectStatus',
        'verifiedByEmail',
        'adminNote',
        'orderDate',
        'completedDate',
        'deliveryEstimate',
        'projectNotes',
        'clientName',
        'clientEmail',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[A-Z0-9\\-]+$') &&
      data.projectTitle is string && data.projectTitle.size() >= 2 && data.projectTitle.size() <= 120 &&
      data.serviceCategory is string && data.serviceCategory.size() <= 50 && data.serviceCategory in [
        'Web Development',
        'App Development',
        'Graphic & Brand Design',
        'Video Editing & Motion',
        'Digital Media & Growth'
      ] &&
      data.packageTier is string && data.packageTier.size() <= 30 && data.packageTier in [
        'Starter',
        'Professional',
        'Enterprise',
        'Custom'
      ] &&
      (data.amountUsd is int || data.amountUsd is float) && data.amountUsd > 0 && data.amountUsd <= 1000000 &&
      (!('amountBdt' in data) || ((data.amountBdt is int || data.amountBdt is float) && data.amountBdt > 0 && data.amountBdt <= 100000000)) &&
      isValidBillingMethod(data.billingMethod) &&
      data.billingReference is string && data.billingReference.size() >= 2 && data.billingReference.size() <= 80 &&
      data.billingStatus is string && data.billingStatus.size() <= 40 && data.billingStatus in [
        'Pending Verification',
        'Paid',
        'Installment (50% Paid)',
        'Rejected'
      ] &&
      data.projectStatus is string && data.projectStatus.size() <= 30 && data.projectStatus in [
        'Pending Verification',
        'Approved',
        'In Progress',
        'In Review',
        'Completed',
        'Rejected',
        'Cancelled'
      ] &&
      (!('verifiedByEmail' in data) || (data.verifiedByEmail is string && data.verifiedByEmail.size() >= 0 && data.verifiedByEmail.size() <= 150)) &&
      (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() >= 0 && data.adminNote.size() <= 300)) &&
      data.orderDate is string && data.orderDate.size() >= 8 && data.orderDate.size() <= 32 &&
      (!('completedDate' in data) || (data.completedDate is string && data.completedDate.size() >= 0 && data.completedDate.size() <= 32)) &&
      data.deliveryEstimate is string && data.deliveryEstimate.size() >= 2 && data.deliveryEstimate.size() <= 60 &&
      data.projectNotes is string && data.projectNotes.size() >= 0 && data.projectNotes.size() <= 1000 &&
      data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
      data.clientEmail is string && data.clientEmail.size() >= 3 && data.clientEmail.size() <= 150 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: CoursePurchase (/coursePurchases/{purchaseId})
    function isValidCoursePurchase(data) {
      return data.keys().hasAll([
        'uid',
        'courseId',
        'courseTitle',
        'courseRoute',
        'courseType',
        'amountBdt',
        'paymentMethod',
        'paymentReference',
        'paymentStatus',
        'studentName',
        'studentEmail',
        'studentPhone',
        'completedLessonIds',
        'completedLessonsCount',
        'totalLessonsCount',
        'progressPct',
        'averageQuizScore',
        'lastActiveLessonTitle',
        'verifiedByEmail',
        'adminNote',
        'purchaseDate',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'courseId',
        'courseTitle',
        'courseRoute',
        'courseType',
        'amountBdt',
        'paymentMethod',
        'paymentReference',
        'paymentStatus',
        'studentName',
        'studentEmail',
        'studentPhone',
        'completedLessonIds',
        'completedLessonsCount',
        'totalLessonsCount',
        'progressPct',
        'averageQuizScore',
        'lastActiveLessonTitle',
        'verifiedByEmail',
        'adminNote',
        'purchaseDate',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.courseId is string && data.courseId.size() >= 2 && data.courseId.size() <= 80 && data.courseId.matches('^[a-z0-9\\-]+$') &&
      data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 150 &&
      data.courseRoute is string && data.courseRoute.size() >= 1 && data.courseRoute.size() <= 100 && data.courseRoute in ['/courses', '/graphic-design-course'] &&
      data.courseType is string && data.courseType in ['Paid Course', 'Free Course'] &&
      (data.amountBdt is int || data.amountBdt is float) && data.amountBdt >= 0 && data.amountBdt <= 500000 &&
      isValidCoursePaymentMethod(data.paymentMethod) &&
      data.paymentReference is string && data.paymentReference.size() >= 2 && data.paymentReference.size() <= 100 &&
      data.paymentStatus is string && data.paymentStatus in ['Pending Verification', 'Verified', 'Rejected'] &&
      data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
      data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 150 &&
      data.studentPhone is string && data.studentPhone.size() >= 0 && data.studentPhone.size() <= 40 &&
      data.completedLessonIds is list && data.completedLessonIds.size() <= 40 &&
      (data.completedLessonIds.size() == 0 || data.completedLessonIds[0] is string) &&
      data.completedLessonsCount is int && data.completedLessonsCount >= 0 && data.completedLessonsCount <= 40 &&
      data.totalLessonsCount is int && data.totalLessonsCount >= 1 && data.totalLessonsCount <= 40 &&
      data.progressPct is int && data.progressPct >= 0 && data.progressPct <= 100 &&
      (data.averageQuizScore is int || data.averageQuizScore is float) && data.averageQuizScore >= 0 && data.averageQuizScore <= 100 &&
      data.lastActiveLessonTitle is string && data.lastActiveLessonTitle.size() >= 0 && data.lastActiveLessonTitle.size() <= 140 &&
      data.verifiedByEmail is string && data.verifiedByEmail.size() >= 0 && data.verifiedByEmail.size() <= 150 &&
      data.adminNote is string && data.adminNote.size() >= 0 && data.adminNote.size() <= 300 &&
      data.purchaseDate is string && data.purchaseDate.size() >= 8 && data.purchaseDate.size() <= 32 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: ServiceApplication (/applications/{applicationId})
    function isValidServiceApplication(data) {
      return data.keys().hasAll([
        'uid',
        'applicationCode',
        'applicationCategory',
        'subject',
        'details',
        'preferredMethod',
        'referenceCode',
        'amountBdt',
        'applicantName',
        'applicantEmail',
        'applicantPhone',
        'status',
        'verifiedByEmail',
        'adminNote',
        'submittedDate',
        'approvedDate',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'applicationCode',
        'applicationCategory',
        'subject',
        'details',
        'preferredMethod',
        'referenceCode',
        'amountBdt',
        'applicantName',
        'applicantEmail',
        'applicantPhone',
        'status',
        'verifiedByEmail',
        'adminNote',
        'submittedDate',
        'approvedDate',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.applicationCode is string && data.applicationCode.size() >= 3 && data.applicationCode.size() <= 40 && data.applicationCode.matches('^[A-Z0-9\\-]+$') &&
      data.applicationCategory is string && data.applicationCategory.size() <= 60 && data.applicationCategory in [
        'AI Workshop 2027 Seat',
        '1-on-1 Mentorship / Consultation',
        'Custom Graphic / Video Quote',
        'Certificate / Verification Request',
        'Partnership / Collaboration',
        'Other Request'
      ] &&
      data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 140 &&
      data.details is string && data.details.size() >= 4 && data.details.size() <= 1500 &&
      isValidApplicationMethod(data.preferredMethod) &&
      data.referenceCode is string && data.referenceCode.size() >= 0 && data.referenceCode.size() <= 100 &&
      (data.amountBdt is int || data.amountBdt is float) && data.amountBdt >= 0 && data.amountBdt <= 500000 &&
      data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 100 &&
      data.applicantEmail is string && data.applicantEmail.size() >= 3 && data.applicantEmail.size() <= 150 &&
      data.applicantPhone is string && data.applicantPhone.size() >= 0 && data.applicantPhone.size() <= 40 &&
      data.status is string && data.status in ['Pending Verification', 'Approved', 'Rejected'] &&
      data.verifiedByEmail is string && data.verifiedByEmail.size() >= 0 && data.verifiedByEmail.size() <= 150 &&
      data.adminNote is string && data.adminNote.size() >= 0 && data.adminNote.size() <= 300 &&
      data.submittedDate is string && data.submittedDate.size() >= 8 && data.submittedDate.size() <= 32 &&
      data.approvedDate is string && data.approvedDate.size() >= 0 && data.approvedDate.size() <= 32 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: WebsiteNotice (/notices/{noticeId})
    function isValidWebsiteNotice(data) {
      return data.keys().hasAll([
        'title',
        'category',
        'body',
        'actionLabel',
        'actionRoute',
        'isPublished',
        'publishedDate',
        'publishedByEmail',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'category',
        'body',
        'actionLabel',
        'actionRoute',
        'isPublished',
        'publishedDate',
        'publishedByEmail',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
      data.category is string && data.category.size() <= 30 && data.category in [
        'General',
        'Course Update',
        'Workshop',
        'Offer',
        'Maintenance'
      ] &&
      data.body is string && data.body.size() >= 4 && data.body.size() <= 1500 &&
      data.actionLabel is string && data.actionLabel.size() >= 0 && data.actionLabel.size() <= 60 &&
      data.actionRoute is string && data.actionRoute.size() >= 0 && data.actionRoute.size() <= 120 &&
      (data.actionRoute == '' || data.actionRoute.matches('^\\/[a-zA-Z0-9\\-_\\/]*$')) &&
      data.isPublished is bool &&
      data.publishedDate is string && data.publishedDate.size() >= 8 && data.publishedDate.size() <= 32 &&
      data.publishedByEmail is string && data.publishedByEmail.size() >= 3 && data.publishedByEmail.size() <= 150 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: BookPurchase (/bookPurchases/{purchaseId})
    function isValidBookPurchase(data) {
      return data.keys().hasAll([
        'uid',
        'bookId',
        'bookTitle',
        'amountBdt',
        'paymentMethod',
        'paymentReference',
        'paymentStatus',
        'buyerName',
        'buyerEmail',
        'buyerPhone',
        'verifiedByEmail',
        'adminNote',
        'purchaseDate',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'bookId',
        'bookTitle',
        'amountBdt',
        'paymentMethod',
        'paymentReference',
        'paymentStatus',
        'buyerName',
        'buyerEmail',
        'buyerPhone',
        'verifiedByEmail',
        'adminNote',
        'purchaseDate',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.bookId is string && data.bookId.size() >= 2 && data.bookId.size() <= 100 && data.bookId.matches('^[a-z0-9\\-]+$') &&
      data.bookTitle is string && data.bookTitle.size() >= 2 && data.bookTitle.size() <= 150 &&
      (data.amountBdt is int || data.amountBdt is float) && data.amountBdt >= 50 && data.amountBdt <= 50000 &&
      isValidBillingMethod(data.paymentMethod) &&
      data.paymentReference is string && data.paymentReference.size() >= 3 && data.paymentReference.size() <= 100 &&
      data.paymentStatus is string && data.paymentStatus in ['Pending Verification', 'Verified', 'Rejected'] &&
      data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 100 &&
      data.buyerEmail is string && data.buyerEmail.size() >= 3 && data.buyerEmail.size() <= 150 &&
      data.buyerPhone is string && data.buyerPhone.size() >= 5 && data.buyerPhone.size() <= 40 &&
      data.verifiedByEmail is string && data.verifiedByEmail.size() >= 0 && data.verifiedByEmail.size() <= 150 &&
      data.adminNote is string && data.adminNote.size() >= 0 && data.adminNote.size() <= 300 &&
      data.purchaseDate is string && data.purchaseDate.size() >= 8 && data.purchaseDate.size() <= 32 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Update Profile & Billing Preferences
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'phone',
            'company',
            'roleTitle',
            'location',
            'preferredBillingMethod',
            'billingDetails',
            'bio',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Collection: /orders/{orderId}
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && (existing().uid == request.auth.uid || isCourseAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isCourseAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidProjectOrder(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().clientEmail == request.auth.token.email &&
        incoming().billingStatus == 'Pending Verification' &&
        incoming().projectStatus == 'Pending Verification' &&
        (!('completedDate' in incoming()) || incoming().completedDate == '') &&
        (!('verifiedByEmail' in incoming()) || incoming().verifiedByEmail == '') &&
        (!('adminNote' in incoming()) || incoming().adminNote == '') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidProjectOrder(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().orderDate == existing().orderDate &&
        incoming().projectTitle == existing().projectTitle &&
        incoming().serviceCategory == existing().serviceCategory &&
        incoming().packageTier == existing().packageTier &&
        incoming().clientName == existing().clientName &&
        incoming().clientEmail == existing().clientEmail &&
        incoming().amountUsd == existing().amountUsd &&
        (!('amountBdt' in existing()) || ('amountBdt' in incoming() && incoming().amountBdt == existing().amountBdt)) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner updates notes/billing reference ONLY while Pending Verification or Rejected (cannot self-approve!)
          (
            existing().uid == request.auth.uid &&
            existing().projectStatus in ['Pending Verification', 'Rejected'] &&
            incoming().billingStatus == 'Pending Verification' &&
            incoming().projectStatus == 'Pending Verification' &&
            (!('adminNote' in incoming()) || incoming().adminNote == '') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'billingMethod',
              'billingReference',
              'billingStatus',
              'projectStatus',
              'adminNote',
              'projectNotes',
              'updatedAt'
            ])
          ) ||
          // Action 2: Primary Admin ONLY approves, marks Completed/Paid, or rejects submitted order
          (
            isCourseAdmin() &&
            incoming().verifiedByEmail == request.auth.token.email &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'projectStatus',
              'billingStatus',
              'completedDate',
              'verifiedByEmail',
              'adminNote',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Collection: /coursePurchases/{purchaseId}
    match /coursePurchases/{purchaseId} {
      allow get: if isVerifiedUser() && isValidId(purchaseId) && (existing().uid == request.auth.uid || isCourseAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isCourseAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(purchaseId) &&
        isValidCoursePurchase(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().studentEmail == request.auth.token.email &&
        purchaseId == request.auth.uid + '_' + incoming().courseId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().courseType == 'Paid Course' &&
            incoming().courseId == 'advanced-graphic-design-ai-live' &&
            incoming().paymentStatus == 'Pending Verification' &&
            incoming().amountBdt >= 6000 &&
            incoming().verifiedByEmail == '' &&
            incoming().adminNote == '' &&
            incoming().completedLessonIds.size() == 0 &&
            incoming().completedLessonsCount == 0 &&
            incoming().progressPct == 0
          ) ||
          (
            incoming().courseType == 'Free Course' &&
            incoming().courseId == 'shohoj-sutre-quran-shikhi' &&
            incoming().paymentStatus == 'Verified' &&
            incoming().amountBdt == 0 &&
            incoming().paymentMethod == 'Free Enrollment' &&
            incoming().verifiedByEmail == '' &&
            incoming().adminNote == ''
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(purchaseId) &&
        isValidCoursePurchase(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().courseId == existing().courseId &&
        incoming().courseTitle == existing().courseTitle &&
        incoming().courseRoute == existing().courseRoute &&
        incoming().courseType == existing().courseType &&
        incoming().amountBdt == existing().amountBdt &&
        incoming().studentName == existing().studentName &&
        incoming().studentEmail == existing().studentEmail &&
        incoming().purchaseDate == existing().purchaseDate &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Verified student updates own lesson completion & quiz progress
          (
            existing().uid == request.auth.uid &&
            existing().paymentStatus == 'Verified' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completedLessonIds',
              'completedLessonsCount',
              'progressPct',
              'averageQuizScore',
              'lastActiveLessonTitle',
              'updatedAt'
            ])
          ) ||
          // Action 2: Student re-submits rejected payment transaction details
          (
            existing().uid == request.auth.uid &&
            existing().paymentStatus == 'Rejected' &&
            incoming().paymentStatus == 'Pending Verification' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentMethod',
              'paymentReference',
              'studentPhone',
              'paymentStatus',
              'adminNote',
              'updatedAt'
            ])
          ) ||
          // Action 3: Primary Admin (sakibulislamsbmc@gmail.com) verifies or rejects submitted payment
          (
            isCourseAdmin() &&
            incoming().verifiedByEmail == request.auth.token.email &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentStatus',
              'verifiedByEmail',
              'adminNote',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Collection: /bookPurchases/{purchaseId}
    match /bookPurchases/{purchaseId} {
      allow get: if isVerifiedUser() && isValidId(purchaseId) && (existing().uid == request.auth.uid || isCourseAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isCourseAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(purchaseId) &&
        isValidBookPurchase(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().buyerEmail == request.auth.token.email &&
        purchaseId == request.auth.uid + '_' + incoming().bookId &&
        incoming().paymentStatus == 'Pending Verification' &&
        incoming().amountBdt >= 50 &&
        incoming().verifiedByEmail == '' &&
        incoming().adminNote == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(purchaseId) &&
        isValidBookPurchase(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().bookId == existing().bookId &&
        incoming().bookTitle == existing().bookTitle &&
        incoming().amountBdt == existing().amountBdt &&
        incoming().buyerName == existing().buyerName &&
        incoming().buyerEmail == existing().buyerEmail &&
        incoming().purchaseDate == existing().purchaseDate &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Buyer re-submits rejected payment transaction details (cannot self-approve)
          (
            existing().uid == request.auth.uid &&
            existing().paymentStatus == 'Rejected' &&
            incoming().paymentStatus == 'Pending Verification' &&
            incoming().adminNote == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentMethod',
              'paymentReference',
              'buyerPhone',
              'paymentStatus',
              'adminNote',
              'updatedAt'
            ])
          ) ||
          // Action 2: Primary Admin ONLY verifies or rejects paid book purchase
          (
            isCourseAdmin() &&
            incoming().verifiedByEmail == request.auth.token.email &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentStatus',
              'verifiedByEmail',
              'adminNote',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Collection: /applications/{applicationId}
    match /applications/{applicationId} {
      allow get: if isVerifiedUser() && isValidId(applicationId) && (existing().uid == request.auth.uid || isCourseAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isCourseAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(applicationId) &&
        isValidServiceApplication(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().applicantEmail == request.auth.token.email &&
        incoming().status == 'Pending Verification' &&
        incoming().verifiedByEmail == '' &&
        incoming().adminNote == '' &&
        incoming().approvedDate == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(applicationId) &&
        isValidServiceApplication(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().applicationCode == existing().applicationCode &&
        incoming().applicationCategory == existing().applicationCategory &&
        incoming().applicantName == existing().applicantName &&
        incoming().applicantEmail == existing().applicantEmail &&
        incoming().submittedDate == existing().submittedDate &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Applicant updates or resubmits while Pending Verification or Rejected (cannot self-approve!)
          (
            existing().uid == request.auth.uid &&
            existing().status in ['Pending Verification', 'Rejected'] &&
            incoming().status == 'Pending Verification' &&
            incoming().adminNote == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subject',
              'details',
              'preferredMethod',
              'referenceCode',
              'amountBdt',
              'applicantPhone',
              'status',
              'adminNote',
              'updatedAt'
            ])
          ) ||
          // Action 2: Primary Admin ONLY approves or rejects application
          (
            isCourseAdmin() &&
            incoming().verifiedByEmail == request.auth.token.email &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'verifiedByEmail',
              'adminNote',
              'approvedDate',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Collection: /notices/{noticeId}
    match /notices/{noticeId} {
      allow get: if isVerifiedUser() && isValidId(noticeId) && (existing().isPublished == true || isCourseAdmin());
      allow list: if isVerifiedUser() && (existing().isPublished == true || isCourseAdmin());
      allow create: if isCourseAdmin() &&
        isValidId(noticeId) &&
        isValidWebsiteNotice(incoming()) &&
        incoming().publishedByEmail == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isCourseAdmin() &&
        isValidId(noticeId) &&
        isValidWebsiteNotice(incoming()) &&
        incoming().publishedByEmail == existing().publishedByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'category',
          'body',
          'actionLabel',
          'actionRoute',
          'isPublished',
          'publishedDate',
          'updatedAt'
        ]);
      allow delete: if isCourseAdmin() && isValidId(noticeId);
    }
  }
}
